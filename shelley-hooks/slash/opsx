#!/usr/bin/env bash
# Shelley slash hook: /opsx
# Proxies to the OpenSpec CLI and inlines the result into the conversation.
set -euo pipefail

# Prefer local user install of openspec
export PATH="$HOME/.local/bin:$PATH"

# Read JSON from stdin (provided by Shelley) if available; ignore otherwise.
if [ -t 0 ]; then
  JSON_STDIN="{}"
else
  JSON_STDIN=$(cat)
fi

ARGS="${SHELLEY_SLASH_ARGS:-}"
CMD="${ARGS%% *}"
REST="${ARGS#* }"
[ "$CMD" = "$ARGS" ] && REST=""

cd "$SHELLEY_CWD"

run() {
  openspec "$@" 2>&1
}

output=""

case "$CMD" in
  status|s)
    output=$(run status)
    ;;
  list)
    output=$(run list $REST)
    ;;
  validate|v)
    output=$(run validate --all)
    ;;
  specs)
    output=$(run list --specs)
    ;;
  changes)
    output=$(run list)
    ;;
  context|c)
    output=$(run context)
    ;;
  propose|p)
    name="${REST%% *}"
    desc="${REST#* }"
    if [ -z "$name" ]; then
      output="Usage: /opsx propose <change-name> [description]"
    else
      output=$(run new change "$name" --description "$desc" 2>&1)
    fi
    ;;
  help|h)
    output="OpenSpec slash hook for Shelley.

Usage:
  /opsx status            - show active OpenSpec status
  /opsx changes           - list active changes
  /opsx specs             - list specs
  /opsx validate          - validate all specs and changes
  /opsx context           - show OpenSpec working context
  /opsx propose <name>    - create a new change proposal
  /opsx <args>            - pass any other args directly to: openspec <args>"
    ;;
  *)
    # Pass anything else directly to openspec
    output=$(run $ARGS 2>&1)
    ;;
esac

printf '%s\n' "$output"
